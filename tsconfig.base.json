{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@realestate-crm/db": ["packages/db/src"],
      "@realestate-crm/db/*": ["packages/db/src/*"],
      "@realestate-crm/ai": ["packages/ai/src"],
      "@realestate-crm/ai/*": ["packages/ai/src/*"],
      "@realestate-crm/types": ["packages/types/src"],
      "@realestate-crm/types/*": ["packages/types/src/*"],
      "@realestate-crm/ui": ["packages/ui/src"],
      "@realestate-crm/ui/*": ["packages/ui/src/*"],
      "@realestate-crm/config": ["packages/config/src"],
      "@realestate-crm/config/*": ["packages/config/src/*"],
      "@realestate-crm/utils": ["packages/utils/src"],
      "@realestate-crm/utils/*": ["packages/utils/src/*"],
      "@realestate-crm/telemetry": ["packages/telemetry/src"],
      "@realestate-crm/telemetry/*": ["packages/telemetry/src/*"]
    }
  }
}
